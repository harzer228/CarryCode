1 ICON "assets/flashgpt.ico"

1 VERSIONINFO
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "CarryCode"
            VALUE "ProductName", "CarryCode"
            VALUE "OriginalFilename", "flashGPT.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
